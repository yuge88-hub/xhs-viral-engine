# ====================== xhs-viral-engine 配置模板 ======================
# 用法: cp .env.example .env, 然后填你自己的 key
# ⚠️ .env 已被 .gitignore 排除, 不会 push 到 GitHub

# DeepSeek API (Skill 1.5 / Skill 4 用 LLM 拆解爆款 + 仿写)
# 申请: https://platform.deepseek.com/api_keys
# 极便宜: deepseek-chat ~¥0.001/1k tokens, 全栈跑一轮 ~¥0.02
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# (可选) DeepSeek v4-flash (reasoning 模式, 4问6维 拆解质量更高)
# DEEPSEEK_MODEL=deepseek-v4-flash

# ====================== 小红书 cookies (Skill 1 / 2 用) ======================
# 不在 .env 里, 用 xhs-cli 命令登录:
#   xhs login    # 扫码登录, cookies 自动保存到 ~/.config/xhs-cli/
# 验证:
#   xhs whoami   # 应返回你的 nickname
